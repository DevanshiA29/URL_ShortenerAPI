# .env.example — Copy to .env and fill in values before running the service.
# This file documents every environment variable the service needs.
# Variables marked REQUIRED have no default and must be set.
# Variables marked OPTIONAL have a default noted in the comment.
#
# NEVER commit .env to git. Only .env.example belongs in version control.
# If .env was ever committed, the secrets in it are compromised — rotate them.

# --- Application ---
NODE_ENV=           # REQUIRED. One of: development | staging | production
PORT=3000           # OPTIONAL. Default: 3000. Integer port the server listens on.

# --- Database ---
MONGODB_URI=        # REQUIRED. Full MongoDB connection string.
                    # Example: mongodb://user:pass@host:27017/dbname
                    # Local dev:  mongodb://localhost:27017/upsk_sdf
                    # Docker dev: mongodb://host.docker.internal:27017/upsk_sdf

# --- Authentication ---
JWT_SECRET=         # REQUIRED. Min 32 characters. Used to sign auth tokens.
                    # Generate with: openssl rand -base64 48

# --- CORS ---
CORS_ORIGIN=        # OPTIONAL. Default: http://localhost:3000
                    # Allowed origin URL for browser requests.

# --- Logging ---
LOG_LEVEL=          # OPTIONAL. Default: info. One of: debug | info | warn | error
                    # Use debug in development, info or warn in production.

REDIS_URL=redis://localhost:6379  # OPTIONAL. Redis connection string for caching
